{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema",
    "gameId",
    "revision",
    "timestamp",
    "eventType",
    "actor",
    "payload"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "schema": {
      "const": "record-audit-event/2"
    },
    "gameId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "eventType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "actor": {
      "enum": [
        "USER",
        "SYSTEM",
        "VISION",
        "RECONSTRUCTION",
        "IMPORT"
      ]
    },
    "payload": {
      "type": "object"
    }
  }
}
