{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema",
    "gameId",
    "order",
    "createdAt",
    "updatedAt",
    "name",
    "declaredMime",
    "detectedMime",
    "mime",
    "animated",
    "size",
    "width",
    "height",
    "sha256"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "schema": {
      "const": "record-source-page/3"
    },
    "gameId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "order": {
      "type": "integer",
      "minimum": 0,
      "maximum": 99
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "name": {
      "type": "string",
      "maxLength": 240
    },
    "declaredMime": {
      "enum": [
        "image/jpeg",
        "image/png"
      ]
    },
    "detectedMime": {
      "enum": [
        "image/jpeg",
        "image/png"
      ]
    },
    "mime": {
      "enum": [
        "image/jpeg",
        "image/png"
      ]
    },
    "animated": {
      "const": false
    },
    "size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20971520
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
