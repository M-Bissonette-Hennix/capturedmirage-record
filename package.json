{
  "name": "record-chess",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "description": "RECORD \u2014 local-first evidentiary ingress for physical chess games.",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check:syntax": "node scripts/syntax-check.mjs",
    "check:schemas": "node scripts/schema-selftest.mjs",
    "check:static": "node scripts/static-qa.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "check": "npm run check:syntax && npm run check:schemas && npm run check:static && npm test",
    "build": "node scripts/build.mjs",
    "release:manifest": "node scripts/release-manifest.mjs",
    "serve": "python3 -m http.server 8080",
    "test:stockfish": "node scripts/stockfish-differential.mjs",
    "check:dist": "node scripts/dist-qa.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "release:package": "node scripts/package-release.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
